{
  "name": "web",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "tsx ./scripts/dev/ensure-db.ts && pnpm prisma:generate && concurrently --kill-others -n web,sync -c blue,magenta \"NEXT_DIST_DIR=.next-dev next dev --turbopack --port 8888\" \"dotenv-flow -e .env -- tsx --conditions=react-server --import=./scripts/runtime/async-local-storage.cjs ./scripts/dev/dev-sync-poller.ts\"",
    "dev:web": "tsx ./scripts/dev/ensure-db.ts && pnpm prisma:generate && NEXT_DIST_DIR=.next-dev next dev --turbopack --port 8888",
    "dev:tunnel": "dotenv-flow -e .env -- tsx ./scripts/dev/run-cloudflare-tunnel.ts",
    "dev:all": "tsx ./scripts/dev/ensure-db.ts && pnpm prisma:generate && concurrently --kill-others -n web,tunnel,shopify,sync -c blue,yellow,green,magenta \"NEXT_DIST_DIR=.next-dev next dev --turbopack --port 8888\" \"dotenv-flow -e .env -- tsx ./scripts/dev/run-cloudflare-tunnel.ts\" \"shopify app dev --path ../../packages/shopify-app --skip-dependencies-installation --tunnel-url https://shopify.weletic.com:3000\" \"dotenv-flow -e .env -- tsx --conditions=react-server --import=./scripts/runtime/async-local-storage.cjs ./scripts/dev/dev-sync-poller.ts\"",
    "dev:sync": "dotenv-flow -e .env -- tsx --conditions=react-server --import=./scripts/runtime/async-local-storage.cjs ./scripts/dev/dev-sync-poller.ts",
    "build": "pnpm prisma:generate && NODE_OPTIONS=\"--max-old-space-size=8192\" next build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "start": "next start",
    "script": "tsx ./scripts/run.ts",
    "test": "pnpm test:unit",
    "test:unit": "pnpm prisma:generate && vitest run --config vitest.config.ts --no-file-parallelism --bail=1",
    "test:integration": "tsx ./scripts/test/require-integration-env.ts && pnpm prisma:generate && vitest run --config vitest.integration.config.ts --no-file-parallelism --bail=1",
    "test:loyalty-db": "vitest run --config vitest.loyalty-db.config.ts --no-file-parallelism --bail=1",
    "test:performance": "pnpm prisma:generate && vitest run --config vitest.performance.config.ts --no-file-parallelism --bail=1",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "generate-openapi": "tsx ./scripts/generate-openapi.ts",
    "prisma:generate": "dotenv-flow -e .env -- prisma generate --schema=./prisma/schema",
    "prisma:push": "dotenv-flow -e .env -- prisma db push --schema=./prisma/schema",
    "prisma:studio": "dotenv-flow -e .env -- prisma studio --schema=./prisma/schema --browser none",
    "prisma:format": "dotenv-flow -e .env -- prisma format --schema=./prisma/schema",
    "test:webhook": "dotenv-flow -e .env -- tsx ./scripts/dev/simulate-shopify-webhook.ts",
    "reconcile:shopify": "dotenv-flow -e .env -- tsx --conditions=react-server --import=./scripts/runtime/async-local-storage.cjs ./scripts/dev/reconcile-shopify.ts",
    "loyalty:outbox-worker": "dotenv-flow -e .env -- tsx --conditions=react-server --import=./scripts/runtime/async-local-storage.cjs ./scripts/loyalty/run-outbox-worker.ts",
    "loyalty:validate-basic-lifecycle": "node -e \"if (process.versions.node.split('.')[0] !== '24') throw new Error('A1 lifecycle validation requires Node 24')\" && node --env-file=.env --conditions=react-server --import=./scripts/runtime/async-local-storage.cjs --import=tsx ./scripts/loyalty/validate-basic-lifecycle.ts",
    "loyalty:validate-financial-rewards": "node --env-file=.env --conditions=react-server --import=./scripts/runtime/async-local-storage.cjs --import=tsx ./scripts/loyalty/validate-financial-reward-lifecycle.ts",
    "loyalty:reconcile-shopify-scopes": "node --env-file=.env --conditions=react-server --import=./scripts/runtime/async-local-storage.cjs --import=tsx ./scripts/loyalty/reconcile-shopify-installation-scopes.ts",
    "loyalty:migrate-ledger-version": "dotenv-flow -e .env -- tsx --conditions=react-server --import=./scripts/runtime/async-local-storage.cjs ./scripts/loyalty/migrate-ledger-version.ts",
    "loyalty:backfill-earn-policy-revisions": "dotenv-flow -e .env -- tsx --conditions=react-server --import=./scripts/runtime/async-local-storage.cjs ./scripts/loyalty/backfill-earn-policy-revisions.ts",
    "loyalty:migrate-discount-codes": "dotenv-flow -e .env -- tsx --conditions=react-server --import=./scripts/runtime/async-local-storage.cjs ./scripts/loyalty/migrate-discount-code-canonical.ts",
    "loyalty:activate-shopify-generation": "dotenv-flow -e .env -- tsx --conditions=react-server --import=./scripts/runtime/async-local-storage.cjs ./scripts/loyalty/activate-shopify-installation-generation.ts",
    "loyalty:audit-privacy-key-retirement": "dotenv-flow -e .env -- tsx --conditions=react-server --import=./scripts/runtime/async-local-storage.cjs ./scripts/loyalty/audit-shopify-privacy-key-retirement.ts",
    "loyalty:validate-test-store": "dotenv-flow -e .env -- tsx --conditions=react-server --import=./scripts/runtime/async-local-storage.cjs ./scripts/loyalty/validate-test-store.ts",
    "loyalty:validate-checkout-matrix": "dotenv-flow -e .env -- tsx --conditions=react-server --import=./scripts/runtime/async-local-storage.cjs ./scripts/loyalty/validate-checkout-refund-matrix.ts",
    "loyalty:validate-theme-proxy": "dotenv-flow -e .env -- tsx --conditions=react-server --import=./scripts/runtime/async-local-storage.cjs ./scripts/loyalty/validate-theme-app-proxy.ts",
    "loyalty:validate-points-expiry": "tsx scripts/loyalty/validate-points-expiry-lifecycle.ts",
    "loyalty:validate-referrals-matrix": "tsx scripts/loyalty/validate-referrals-matrix.ts",
    "loyalty:validate-vip-lifecycle": "tsx scripts/loyalty/validate-vip-lifecycle.ts",
    "loyalty:validate-earning-actions": "tsx scripts/loyalty/validate-earning-actions.ts",
    "loyalty:validate-flow-esp": "tsx scripts/loyalty/validate-flow-esp-integrations.ts",
    "loyalty:validate-store-credit-gift-cards": "tsx scripts/loyalty/validate-store-credit-gift-cards.ts",
    "loyalty:validate-bonus-campaigns": "tsx scripts/loyalty/validate-bonus-campaigns.ts",
    "loyalty:validate-analytics": "node --env-file=.env --conditions=react-server --import=./scripts/runtime/async-local-storage.cjs --import=tsx ./scripts/loyalty/validate-loyalty-analytics.ts",
    "loyalty:validate-historical-backfill": "dotenv-flow -e .env -- tsx --conditions=react-server --import=./scripts/runtime/async-local-storage.cjs ./scripts/loyalty/validate-historical-backfill.ts",
    "loyalty:audit-backfill": "dotenv-flow -e .env -- tsx --conditions=react-server --import=./scripts/runtime/async-local-storage.cjs ./scripts/loyalty/audit-repair-historical-backfill.ts"
  },

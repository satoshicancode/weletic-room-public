model Postback {
  id         String    @id
  partnerId  String
  name       String
  url        String
  secret     String
  triggers   Json
  receiver   String
  disabledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index(partnerId)
}

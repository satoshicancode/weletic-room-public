model WeleticShopperDeliveryReservation {
  id                     String    @id
  storeId                String
  installationGeneration String
  producer               String
  provider               String
  contentDigest          String
  state                  String    @default("attempted")
  capacityAt             DateTime
  expiresAt              DateTime?
  retryUntil             DateTime
  attemptedAt            DateTime?
  sentAt                 DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  store      WeleticShopifyStore              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  identities WeleticShopperDeliveryIdentity[]

  @@unique([storeId, id])
  @@index([storeId, capacityAt, id], map: "wl_delivery_capacity_idx")
}

model WeleticShopperDeliveryIdentity {
  id             String @id
  storeId        String
  reservationId  String
  identityKind   String
  identityKeyId  String
  customerDigest String

  reservation WeleticShopperDeliveryReservation @relation(fields: [storeId, reservationId], references: [storeId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([storeId, reservationId, identityKind, identityKeyId], map: "wl_delivery_identity_unique")
  @@index([storeId, identityKind, identityKeyId, customerDigest], map: "wl_delivery_identity_lookup_idx")
}

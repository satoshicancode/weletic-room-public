// Durable Shopify compliance plane (ADR 0015).
// Direct customer and shop identifiers are encrypted transiently or represented
// by versioned keyed-HMAC identities. Tombstones never retain the raw subject.

enum WeleticComplianceRequestType {
  customer_data_request
  customer_redact
  shop_redact
  app_uninstalled
}

enum WeleticComplianceRequestStatus {
  pending
  processing
  retrying
  completed
  dead_letter
}

enum WeleticVoucherCleanupSource {
  customer_redact
  app_uninstalled
  shop_redact
  review_invalidation
}

enum WeleticVoucherCleanupStatus {
  pending
  processing
  retrying
  completed
  dead_letter
  cancelled
}

enum WeleticCustomerPrivacyIdentityKind {
  customer_id
  customer_email
}

model WeleticShopifyComplianceRequest {
  id                      String                              @id
  storeId                 String
  webhookId               String                              @unique
  shopDomain              String
  requestType             WeleticComplianceRequestType
  authenticatedBodyDigest String?                             @db.VarChar(191)
  status                  WeleticComplianceRequestStatus      @default(pending)
  phase                   String                              @default("received")
  subjectKind             WeleticCustomerPrivacyIdentityKind?
  subjectKeyId            String?
  subjectDigest           String?
  payloadCiphertext       String?                             @db.LongText
  cursor                  Json?                               @db.Json
  progress                Json?                               @db.Json
  attempts                Int                                 @default(0)
  maxAttempts             Int                                 @default(10)
  leaseVersion            Int                                 @default(0)
  lockedAt                DateTime?
  lockedBy                String?
  nextRetryAt             DateTime?
  lastError               String?                             @db.Text
  triggeredAt             DateTime?
  receivedAt              DateTime                            @default(now())
  startedAt               DateTime?
  completedAt             DateTime?
  createdAt               DateTime                            @default(now())
  updatedAt               DateTime                            @updatedAt

  store                     WeleticShopifyStore                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  artifacts                 WeleticShopifyComplianceArtifact[]
  customerTombstones        WeleticShopifyCustomerPrivacyTombstone[]  @relation("CustomerPrivacyTombstoneRequest")
  shopTombstones            WeleticShopifyShopPrivacyTombstone[]      @relation("ShopPrivacyTombstoneRequest")
  originatedVoucherCleanups WeleticShopifyVoucherCleanup[]            @relation("VoucherCleanupRequest")
  voucherCleanupLinks       WeleticShopifyVoucherCleanupRequestLink[] @relation("ComplianceRequestVoucherCleanupLinks")

  @@unique([storeId, id])
  @@index([status, nextRetryAt])
  @@index([storeId, requestType, status])
  @@index([lockedAt])
  @@index([createdAt])
}

model WeleticShopifyComplianceArtifact {
  id                      String    @id
  requestId               String
  storeId                 String
  kind                    String
  sequence                Int
  storageKey              String    @db.Text
  encryptionVersion       String
  contentSha256           String
  byteSize                BigInt
  expiresAt               DateTime
  downloadTokenHash       String?
  downloadTokenCiphertext String?   @db.Text
  downloadTokenKeyId      String?
  downloadTokenExpiresAt  DateTime?
  deliveredAt             DateTime?
  downloadedAt            DateTime?
  deletedAt               DateTime?
  lastError               String?   @db.Text
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  request WeleticShopifyComplianceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  store   WeleticShopifyStore             @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([requestId, kind, sequence])
  @@index([storeId, expiresAt])
  @@index([expiresAt, deletedAt])
}

model WeleticShopifyCustomerPrivacyTombstone {
  // The datasource uses relationMode="prisma", so MySQL does not receive a
  // physical FK. Composite relations still define the generated-client
  // contract; the sole writer additionally validates both owners in the same
  // transaction before persisting either optional link.
  id              String                             @id
  storeId         String
  identityKind    WeleticCustomerPrivacyIdentityKind
  identityKeyId   String
  customerDigest  String
  shopperId       String?
  accountId       String?
  sourceRequestId String?
  redactedAt      DateTime
  expiresAt       DateTime
  createdAt       DateTime                           @default(now())
  updatedAt       DateTime                           @updatedAt

  store         WeleticShopifyStore              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  // Owner links deliberately reuse this tombstone's storeId. Composite owner
  // relations make a cross-store shopper/account unrepresentable through the
  // Prisma schema contract. Retained financial owners are pseudonymous and
  // cleared explicitly before deletion; NoAction preserves the tombstone.
  shopper       WeleticShopper?                  @relation(fields: [storeId, shopperId], references: [storeId, id], onDelete: NoAction, onUpdate: NoAction)
  account       WeleticLoyaltyAccount?           @relation(fields: [storeId, accountId], references: [storeId, id], onDelete: NoAction, onUpdate: NoAction)
  sourceRequest WeleticShopifyComplianceRequest? @relation("CustomerPrivacyTombstoneRequest", fields: [sourceRequestId], references: [id], onDelete: SetNull)

  @@unique([storeId, identityKind, identityKeyId, customerDigest])
  @@index([storeId, expiresAt])
  @@index([storeId, shopperId])
  @@index([storeId, accountId])
  @@index([sourceRequestId])
}

model WeleticShopifyShopPrivacyTombstone {
  id               String   @id
  storeId          String
  identityKeyId    String
  shopDomainDigest String
  sourceRequestId  String?
  redactedAt       DateTime
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  store         WeleticShopifyStore              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sourceRequest WeleticShopifyComplianceRequest? @relation("ShopPrivacyTombstoneRequest", fields: [sourceRequestId], references: [id], onDelete: SetNull)

  @@unique([identityKeyId, shopDomainDigest])
  @@index([storeId, expiresAt])
  @@index([sourceRequestId])
}

model WeleticShopifyVoucherCleanup {
  id                            String                      @id
  storeId                       String
  redemptionId                  String
  sourceRequestId               String?
  source                        WeleticVoucherCleanupSource
  status                        WeleticVoucherCleanupStatus @default(pending)
  expectedDiscountCode          String
  expectedDiscountCodeCanonical String
  expectedDiscountId            String?
  ownershipSnapshot             Json?                       @db.Json
  attempts                      Int                         @default(0)
  maxAttempts                   Int                         @default(10)
  leaseVersion                  Int                         @default(0)
  lockedAt                      DateTime?
  lockedBy                      String?
  nextRetryAt                   DateTime?
  lastError                     String?                     @db.Text
  remoteVerifiedAt              DateTime?
  remoteUsageCount              Int?
  remoteUsageObservedAt         DateTime?
  remoteDeactivationStartedAt   DateTime?
  remoteDeactivatedAt           DateTime?
  remoteOutcome                 String?
  completedAt                   DateTime?
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt

  store              WeleticShopifyStore                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sourceRequest      WeleticShopifyComplianceRequest?          @relation("VoucherCleanupRequest", fields: [sourceRequestId], references: [id], onDelete: SetNull)
  requestLinks       WeleticShopifyVoucherCleanupRequestLink[] @relation("VoucherCleanupRequestLinks")
  reviewInvalidation WeleticReviewIncentiveInvalidation?

  @@unique([storeId, redemptionId])
  @@unique([storeId, id])
  @@index([status, nextRetryAt])
  @@index([storeId, status])
  @@index([lockedAt])
  @@index([sourceRequestId])
}

// One durable cleanup may be shared by customer-redact, uninstall, and
// shop-redact requests. The link set lets each bounded request wait for only
// its own cleanup rows without copying an unbounded list into JSON progress.
model WeleticShopifyVoucherCleanupRequestLink {
  id        String   @id
  storeId   String
  requestId String
  cleanupId String
  createdAt DateTime @default(now())

  store   WeleticShopifyStore             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  request WeleticShopifyComplianceRequest @relation("ComplianceRequestVoucherCleanupLinks", fields: [storeId, requestId], references: [storeId, id], onDelete: Cascade)
  cleanup WeleticShopifyVoucherCleanup    @relation("VoucherCleanupRequestLinks", fields: [storeId, cleanupId], references: [storeId, id], onDelete: Cascade)

  @@unique([requestId, cleanupId])
  @@index([storeId, requestId])
  @@index([storeId, cleanupId])
}

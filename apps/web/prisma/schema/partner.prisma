// https://devdocs.veriff.com/v1/docs/how-to-generate-sessions-manually#verification-session-statuses
model Partner {
  id                       String  @id @default(cuid())
  name                     String
  username                 String? @unique
  email                    String? @unique
  image                    String?
  description              String?
  country                  String?
  preferredLocale          String  @default("en")
  timeZone                 String  @default("UTC")
  preferredDisplayCurrency String?
  preferredPayoutCurrency  String?
  companyName              String?
  profileType              String  @default("individual")
  networkStatus            String  @default("draft")

  // identity verification fields
  identityVerificationStatus String?
  identityVerifiedAt         DateTime?
  veriffSessionId            String?   @unique
  veriffMetadata             Json? // see veriffMetadataSchema

  // payout fields
  defaultPayoutMethod          String?
  payoutsEnabledAt             DateTime?
  connectPayoutsLastRemindedAt DateTime?
  paypalEmail                  String?   @unique
  stripeConnectId              String?   @unique
  stripeRecipientId            String?   @unique
  payoutMethodHash             String?
  cryptoWalletAddress          String?
  tremendousEmail              String?

  // timestamp fields
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  submittedAt DateTime?
  reviewedAt  DateTime?
  trustedAt   DateTime?

  // miscellaneous fields
  invoiceSettings     Json?
  changeHistoryLog    Json?
  referredByPartnerId String?

  programs                   ProgramEnrollment[]
  users                      PartnerUser[]
  invites                    PartnerInvite[]
  links                      Link[]
  customers                  Customer[]
  payouts                    Payout[]
  commissions                Commission[]
  bountySubmissions          BountySubmission[]
  postbacks                  Postback[]
  messages                   Message[]
  sentMessages               Message[]                          @relation("SenderPartner")
  comments                   PartnerComment[]
  discountCodes              DiscountCode[]
  notificationEmails         NotificationEmail[]
  monthlyTraffic             String?
  industryInterests          PartnerIndustryInterest[]
  preferredEarningStructures PartnerPreferredEarningStructure[]
  salesChannels              PartnerSalesChannel[]
  discoveredByPrograms       DiscoveredPartner[]
  programPartnerTags         ProgramPartnerTag[]
  fraudEventGroups           FraudEventGroup[]
  fraudEvents                FraudEvent[]
  fraudAlerts                FraudAlert[]
  partnerRewinds             PartnerRewind[]
  platforms                  PartnerPlatform[]
  referredApplications       ProgramApplicationEvent[]
  submittedLeads             SubmittedLead[]

  @@index(country)
  @@index(networkStatus)
  @@index(createdAt)
  @@index(payoutMethodHash)
  @@index(cryptoWalletAddress)
  @@index(identityVerifiedAt)
  @@index(referredByPartnerId)
  @@index(tremendousEmail)
}

model PartnerInvite {
  email     String
  expires   DateTime
  partnerId String
  role      String   @default("member")
  createdAt DateTime @default(now())

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([email, partnerId])
  @@index(partnerId)
}

model PartnerUser {
  id        String   @id @default(cuid())
  role      String   @default("member")
  userId    String
  partnerId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  notificationPreferences PartnerNotificationPreferences?

  @@unique([userId, partnerId])
  @@index(partnerId)
}

model PartnerIndustryInterest {
  partnerId        String
  industryInterest String

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, industryInterest])
}

model PartnerPreferredEarningStructure {
  partnerId                 String
  preferredEarningStructure String

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, preferredEarningStructure])
}

model PartnerSalesChannel {
  partnerId    String
  salesChannel String

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, salesChannel])
}

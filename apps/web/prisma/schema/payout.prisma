model Payout {
  id                  String    @id
  programId           String
  partnerId           String
  invoiceId           String?
  amount              Int       @default(0)
  currency            String    @default("USD")
  status              String    @default("pending")
  mode                String?
  method              String?
  description         String?
  periodStart         DateTime?
  periodEnd           DateTime?
  paypalTransferId    String?   @unique
  stripeTransferId    String?
  stripePayoutId      String?
  stripePayoutTraceId String?
  tremendousOrderId   String?
  failureReason       String?
  webhookEventId      String?   @unique // only for external payouts
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  userId      String? // user who made the payout
  initiatedAt DateTime?
  paidAt      DateTime?

  program           Program           @relation(fields: [programId], references: [id])
  partner           Partner           @relation(fields: [partnerId], references: [id])
  programEnrollment ProgramEnrollment @relation(fields: [partnerId, programId], references: [partnerId, programId])
  invoice           Invoice?          @relation(fields: [invoiceId], references: [id])
  user              User?             @relation(fields: [userId], references: [id])
  commissions       Commission[]

  @@index([programId, status])
  @@index([programId, partnerId]) // for programEnrollment relation
  @@index(partnerId)
  @@index(invoiceId)
  @@index(status)
  @@index([updatedAt, status]) // used for reconcile-amounts cron job
  @@index(method)
  @@index(userId)
  @@index(stripePayoutId)
  @@index(stripeTransferId)
  @@index(tremendousOrderId)
}

model Campaign {
  id              String               @id
  programId       String
  workflowId      String?              @unique
  userId          String
  qstashMessageId String?              @unique
  type            String
  status          String               @default("draft")
  name            String
  subject         String
  preview         String?
  from            String?
  bodyJson        Json
  scheduledAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  program         Program              @relation(fields: [programId], references: [id])
  workflow        Workflow?            @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  groups          CampaignGroup[]
  partnerTags     CampaignPartnerTag[]
  emails          NotificationEmail[]

  @@index(programId)
}

model CampaignGroup {
  id         String @id @default(cuid())
  campaignId String
  groupId    String

  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  partnerGroup PartnerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([campaignId, groupId])
  @@index(groupId)
}

model CampaignPartnerTag {
  id           String @id @default(cuid())
  campaignId   String
  partnerTagId String

  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  partnerTag PartnerTag @relation(fields: [partnerTagId], references: [id], onDelete: Cascade)

  @@unique([campaignId, partnerTagId])
  @@index(partnerTagId)
}

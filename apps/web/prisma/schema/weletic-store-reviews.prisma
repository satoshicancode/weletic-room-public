// Store-experience feedback is separate from historical product reviews.
// Reader/privacy readiness and an explicit merchant revision precede writers.
model WeleticStoreReviewSettings {
  id                  String    @id
  storeId             String    @unique
  revision            Int       @default(1)
  enabled             Boolean   @default(false)
  requestEmailEnabled Boolean   @default(false)
  activatedAt         DateTime?
  autoPublish         Boolean   @default(false)
  sendAfterDays       Int       @default(7)
  expiresAfterDays    Int       @default(30)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  store WeleticShopifyStore @relation(fields: [storeId], references: [id], onDelete: Restrict)
}

// Exactly one invitation per order. Policy is the original order-wide promise,
// never a separate store-review reward policy or a freshly evaluated setting.
model WeleticStoreReviewRequest {
  id                        String    @id
  storeId                   String
  orderId                   String
  shopperId                 String
  incentivePolicyId         String?
  installationGeneration    String
  settingsRevision          Int
  status                    String    @default("queued")
  fulfilledAt               DateTime
  sendAt                    DateTime
  expiresAt                 DateTime
  tokenHash                 String?   @unique
  encryptedDeliveryToken    String?
  encryptedDeliverySnapshot String?
  deliveryToken             String?
  deliveryLeaseExpiresAt    DateTime?
  deliveryReservedAt        DateTime?
  deliveryAttempts          Int       @default(0)
  lastError                 String?
  sentAt                    DateTime?
  submittedAt               DateTime?
  cancelledAt               DateTime?
  cancellationReason        String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  store           WeleticShopifyStore             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  order           WeleticCommerceOrder            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shopper         WeleticShopper                  @relation(fields: [storeId, shopperId], references: [storeId, id], onDelete: Restrict)
  incentivePolicy WeleticReviewIncentivePolicy?   @relation(fields: [storeId, incentivePolicyId], references: [storeId, id], onDelete: Restrict)
  lines           WeleticStoreReviewRequestLine[]
  review          WeleticStoreReview?

  @@unique([storeId, id])
  @@unique([storeId, orderId])
  @@index(orderId)
  @@index([storeId, shopperId])
  @@index([storeId, incentivePolicyId])
  @@index([storeId, status, sendAt, id], map: "store_review_request_due")
  @@index([status, deliveryLeaseExpiresAt], map: "store_review_request_lease")
  @@index([expiresAt, id], map: "store_review_request_expiry")
}

model WeleticStoreReviewRequestLine {
  id                String @id
  requestId         String
  storeId           String
  orderLineId       String
  purchasedQuantity Int

  request   WeleticStoreReviewRequest @relation(fields: [storeId, requestId], references: [storeId, id], onDelete: Restrict)
  orderLine WeleticCommerceOrderLine  @relation(fields: [orderLineId], references: [id], onDelete: Restrict)

  @@unique([requestId, orderLineId])
  @@index([storeId, requestId])
  @@index(orderLineId)
}

model WeleticStoreReview {
  id                              String    @id
  storeId                         String
  // Imported content must not manufacture a Shopify customer. Authenticated
  // and invitation writers require an actual same-store shopper in service code.
  shopperId                       String?
  requestId                       String?   @unique
  source                          String
  status                          String    @default("pending")
  version                         Int       @default(1)
  rating                          Int
  title                           String
  body                            String
  displayName                     String
  locale                          String
  merchantReply                   String?
  verifiedPurchase                Boolean   @default(false)
  incentivized                    Boolean   @default(false)
  participationStatus             String    @default("pending")
  participationValidatedAt        DateTime?
  participationValidationRevision String?
  participationContentDigest      String?
  rewardStatus                    String    @default("ineligible")
  rewardLedgerId                  String?
  rewardReason                    String?
  publishedAt                     DateTime?
  moderatedAt                     DateTime?
  redactedAt                      DateTime?
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt

  store            WeleticShopifyStore                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  shopper          WeleticShopper?                     @relation(fields: [storeId, shopperId], references: [storeId, id], onDelete: Restrict)
  request          WeleticStoreReviewRequest?          @relation(fields: [storeId, requestId], references: [storeId, id], onDelete: Restrict)
  moderationAudits WeleticStoreReviewModerationAudit[]

  @@unique([storeId, id])
  @@unique([storeId, requestId])
  @@index([storeId, shopperId])
  @@index([storeId, status, createdAt, id], map: "store_review_listing")
  @@index([storeId, redactedAt, id], map: "store_review_privacy")
}

model WeleticStoreReviewModerationAudit {
  id                     String    @id
  storeId                String
  reviewId               String
  actorKind              String
  actorUserId            String?
  appId                  String?
  installationGeneration String
  merchantActionId       String?
  reasonCode             String
  reasonDetails          String?
  fromVersion            Int
  toVersion              Int
  fromStatus             String
  toStatus               String
  replyChanged           Boolean
  redactedAt             DateTime?
  createdAt              DateTime  @default(now())

  review WeleticStoreReview @relation(fields: [storeId, reviewId], references: [storeId, id], onDelete: Restrict)

  @@unique([storeId, reviewId, toVersion], map: "store_review_moderation_version")
  @@index([storeId, createdAt, id], map: "store_review_moderation_created")
  @@index([storeId, redactedAt, id], map: "store_review_moderation_privacy")
}

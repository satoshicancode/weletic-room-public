{% comment %}
  Weletic Loyalty Landing Page Section Block
  Provides a full-page rewards showcase: Hero, Tiers Breakdown,
  Ways to Earn, Ways to Redeem, and Referral Hub.
  Strictly compliant with Zero-PII DOM architecture.
{% endcomment %}

{{ 'weletic-loyalty-styles.css' | asset_url | stylesheet_tag }}

{% liquid
  assign loyalty_locale = request.locale.iso_code | downcase | replace: '_', '-' | split: '-' | first
  assign loyalty_loading_balance = 'Loading your member rewards balance...'
  assign loyalty_loading_program = 'Loading loyalty program details...'
  assign loyalty_join = 'Join Now & Earn Points'
  assign loyalty_sign_in = 'Already a Member? Sign In'
  if loyalty_locale == 'ja'
    assign loyalty_loading_balance = '会員特典の残高を読み込み中…'
    assign loyalty_loading_program = '特典プログラムを読み込み中…'
    assign loyalty_join = '登録してポイントを貯める'
    assign loyalty_sign_in = '会員の方はこちらからログイン'
  elsif loyalty_locale == 'vi'
    assign loyalty_loading_balance = 'Đang tải số dư phần thưởng thành viên…'
    assign loyalty_loading_program = 'Đang tải thông tin chương trình…'
    assign loyalty_join = 'Tham gia và tích điểm'
    assign loyalty_sign_in = 'Đã là thành viên? Đăng nhập'
  endif
%}

<div
  id="weletic-loyalty-landing-root-{{ block.id | escape }}"
  class="weletic-landing-container"
  data-weletic-loyalty-landing-root
  data-weletic-instance-id="{{ block.id | escape }}"
  data-locale="{{ request.locale.iso_code | escape }}"
  data-shop="{{ shop.permanent_domain | escape }}"
  data-logged-in="{% if customer %}true{% else %}false{% endif %}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency | escape }}"
  data-login-url="{{ routes.account_login_url | escape }}"
  data-register-url="{{ routes.account_register_url | escape }}"
  data-proxy-prefix="{{ block.settings.proxy_prefix | default: '/apps/weletic' | escape }}"
  data-primary-color="{{ block.settings.primary_color | default: '#6366f1' | escape }}"
  data-show-tiers="{{ block.settings.show_tiers | escape }}"
  data-show-earn="{{ block.settings.show_earn | escape }}"
  data-show-redeem="{{ block.settings.show_redeem | escape }}"
  data-show-referrals="{{ block.settings.show_referrals | escape }}"
  data-show-faq="{{ block.settings.show_faq | escape }}"
>
  <!-- Hero Section -->
  <div class="weletic-landing-hero">
    <h1 class="weletic-landing-title">{{ block.settings.hero_title | default: 'VIP Rewards Program' | escape }}</h1>
    <p class="weletic-landing-subtitle">
      {{ block.settings.hero_subtitle | default: 'Earn points every time you shop, unlock exclusive VIP tiers, and redeem rewards.' | escape }}
    </p>

    <div
      class="weletic-landing-auth-cta"
      id="weletic-landing-auth-banner-{{ block.id | escape }}"
      data-weletic-landing-auth-banner
    >
      {% if customer %}
        <div class="weletic-landing-user-badge">
          <span class="weletic-spinner-sm"></span> {{ loyalty_loading_balance | escape }}
        </div>
      {% else %}
        <div class="weletic-landing-guest-actions">
          <a href="{{ routes.account_register_url | escape }}" class="weletic-btn-hero-primary">{{ loyalty_join | escape }}</a>
          <a href="{{ routes.account_login_url | escape }}" class="weletic-btn-hero-secondary">{{ loyalty_sign_in | escape }}</a>
        </div>
      {% endif %}
    </div>
  </div>

  <!-- Dynamic Content Sections Injected via weletic-loyalty-landing.js -->
  <div
    id="weletic-landing-sections-{{ block.id | escape }}"
    class="weletic-landing-content"
    data-weletic-landing-sections
  >
    <div class="weletic-loading-placeholder">
      <div class="weletic-spinner"></div>
      <p>{{ loyalty_loading_program | escape }}</p>
    </div>
  </div>
</div>

<script
  defer
  src="{{ 'weletic-loyalty-shared.js' | asset_url | escape }}"
></script>
<script
  defer
  src="{{ 'weletic-loyalty-landing.js' | asset_url | escape }}"
></script>

{% schema %}
{
  "name": "Loyalty Landing Page",
  "target": "section",
  "settings": [
    {
      "type": "header",
      "content": "Hero Banner"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "VIP Rewards Program"
    },
    {
      "type": "textarea",
      "id": "hero_subtitle",
      "label": "Hero Subtitle",
      "default": "Earn points every time you shop, unlock exclusive VIP tiers, and redeem rewards."
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Accent Color",
      "default": "#6366f1"
    },
    {
      "type": "header",
      "content": "Section Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_tiers",
      "label": "Show VIP Tiers Breakdown",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_earn",
      "label": "Show Ways to Earn Points",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_redeem",
      "label": "Show Ways to Redeem Rewards",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_referrals",
      "label": "Show Refer-a-Friend Section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_faq",
      "label": "Show FAQ Section",
      "default": true
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "text",
      "id": "proxy_prefix",
      "label": "App Proxy Subpath",
      "default": "/apps/weletic"
    }
  ]
}
{% endschema %}

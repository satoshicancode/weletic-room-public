{
  "name": "@weletic/shopify-app",
  "version": "1.0.0",
  "private": true,
  "description": "Official Shopify Embedded App for Weletic Room Conversion Analytics",
  "type": "module",
  "scripts": {
    "dev": "remix vite:dev",
    "build": "remix vite:build",
    "start": "remix-serve ./build/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "deploy": "shopify app deploy"
  },
  "dependencies": {
    "@remix-run/node": "^2.15.2",
    "@remix-run/react": "^2.15.2",
    "@remix-run/serve": "^2.15.2",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/polaris": "^13.9.2",
    "@shopify/polaris-icons": "^9.3.0",
    "@shopify/shopify-api": "^13.1.0",
    "@shopify/shopify-app-remix": "^4.2.1",
    "@shopify/shopify-app-session-storage": "^5.0.1",
    "@shopify/shopify_function": "~2.0.0",
    "@shopify/ui-extensions": "2026.7.0",
    "@vercel/remix": "^2.15.2",
    "isbot": "^5.1.22",
    "preact": "10.29.8",
    "react": "19.1.3",
    "react-dom": "19.1.3"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "5.0.6",
    "@remix-run/dev": "^2.15.2",
    "@shopify/cli": "4.7.0",
    "@types/react": "19.1.15",
    "@types/react-dom": "19.1.9",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "4.0.8"
  }
}
